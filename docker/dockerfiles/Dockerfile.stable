# ================================
# Build arguments
# ================================
ARG ROS_DISTRO=rolling

# ================================
# Stage 1: Builder
# ================================
FROM ros:${ROS_DISTRO}-ros-base AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.cargo/bin:${PATH}"

# ---- Build dependencies only ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    curl \
    pkg-config \
    libssl-dev \
    libsrtp2-dev \
    libnice-dev \
    libglib2.0-dev \
    libjsoncpp-dev \
    libyaml-cpp-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    gstreamer1.0-alsa \
    gstreamer1.0-gl \
    gstreamer1.0-gtk3 \
    gstreamer1.0-qt5 \
    gstreamer1.0-pulseaudio \
    && rm -rf /var/lib/apt/lists/*

# ---- Install Rust (for gstscream) ----
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y

# ================================
# Fetch SCReAM
# ================================
WORKDIR /opt
RUN git clone --depth=1 https://github.com/EricssonResearch/scream.git

# ==================================================
# Build gstscream (Rust / GStreamer plugin)
# ==================================================
WORKDIR /opt/scream/gstscream/scripts
RUN ./build.sh --release

# Strip Rust shared objects
RUN find /opt/scream/gstscream/target -name "*.so" -exec strip --strip-unneeded {} + || true

# ==================================================
# Build SCReAM sender/receiver (CMake version)
# ==================================================
WORKDIR /opt/scream/multicam/sender/scream

RUN mkdir -p build && \
    cd build && \
    cmake .. && \
    make -j$(nproc)

WORKDIR /opt/scream/multicam/receiver/scream

RUN mkdir -p build && \
    cd build && \
    cmake .. && \
    make -j$(nproc)

# Strip binaries
RUN strip /opt/scream/multicam/sender/scream/bin/scream_sender || true && \
    strip /opt/scream/multicam/receiver/scream/bin/scream_receiver || true

# ================================
# Stage 2: Runtime (stable)
# ================================
FROM ros:${ROS_DISTRO}-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=${ROS_DISTRO}

# ================================
# Runtime dependencies only
# ================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # ---- GStreamer runtime ----
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-rtsp \
    # ---- Networking / L4S ----
    iproute2 \
    ethtool \
    tcpdump \
    iputils-ping \
    libsrtp2-1 \
    libnice10 \
    libjsoncpp25 \
    libyaml-cpp0.8 \
    # ---- Misc ----
    psmisc \
    ca-certificates \
    bash \
    && rm -rf /var/lib/apt/lists/*

# ================================
# Runtime layout
# ================================
RUN mkdir -p \
    /opt/scream/bin \
    /opt/scream/gstscream \
    /opt/scream/code

# ================================
# Copy gstscream
# ================================
COPY --from=builder /opt/scream/gstscream/scripts /opt/scream/gstscream/scripts
COPY --from=builder /opt/scream/gstscream/target/debug /opt/scream/gstscream/target/debug
COPY --from=builder /opt/scream/code/wrapper_lib /opt/scream/code/wrapper_lib

# ================================
# Copy SCReAM sender/receiver binaries
# ================================
COPY --from=builder \
    /opt/scream/multicam/sender/scream/bin/scream_sender \
    /opt/scream/bin/scream_sender

COPY --from=builder \
    /opt/scream/multicam/receiver/scream/bin/scream_receiver \
    /opt/scream/bin/scream_receiver

RUN chmod +x /opt/scream/bin/scream_sender \
             /opt/scream/bin/scream_receiver

# ================================
# Environment
# ================================
ENV GST_PLUGIN_PATH=/opt/scream/gstscream/target/release:/usr/lib/x86_64-linux-gnu/gstreamer-1.0
ENV LD_LIBRARY_PATH=/opt/scream/code/wrapper_lib

# ================================
# Entrypoint
# ================================
COPY entrypoints/entrypoint_stable.sh /entrypoint_stable.sh
RUN chmod +x /entrypoint_stable.sh

ENTRYPOINT ["/entrypoint_stable.sh"]
CMD ["bash"]
