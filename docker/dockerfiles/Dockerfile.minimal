# ================================
# Build arguments (easy upgrades)
# ================================
ARG ROS_DISTRO=rolling

# ================================
# Stage 1: Builder
# ================================
FROM ros:${ROS_DISTRO}-ros-base AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PATH="/root/.cargo/bin:${PATH}"

# ---- Build dependencies only ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    curl \
    pkg-config \
    libssl-dev \
    libsrtp2-dev \
    libnice-dev \
    libglib2.0-dev \
    libjsoncpp-dev \
    libyaml-cpp-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# ---- Install Rust (for gstscream) ----
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y

# ================================
# Fetch SCReAM
# ================================
WORKDIR /opt
RUN git clone --depth=1 https://github.com/EricssonResearch/scream.git

# ================================
# Build gstscream (Rust plugin)
# ================================
WORKDIR /opt/scream/gstscream/scripts
RUN ./build.sh --release

# Strip Rust shared objects
RUN find /opt/scream/gstscream/target/debug -name "*.so" \
    -exec strip --strip-unneeded {} + || true

# ================================
# Build SCReAM sender / receiver
# ================================
WORKDIR /opt/scream/multicam/sender/scream
RUN mkdir -p build && cd build && cmake .. && make -j$(nproc)

WORKDIR /opt/scream/multicam/receiver/scream
RUN mkdir -p build && cd build && cmake .. && make -j$(nproc)

# Strip binaries
RUN strip /opt/scream/multicam/sender/scream/bin/scream_sender || true && \
    strip /opt/scream/multicam/receiver/scream/bin/scream_receiver || true

# ================================
# Stage 2: Runtime (minimal)
# ================================
FROM ros:${ROS_DISTRO}-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=${ROS_DISTRO}

# ---- Runtime dependencies only ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    iproute2 \
    iputils-ping \
    libsrtp2-1 \
    libnice10 \
    libjsoncpp25 \
    libyaml-cpp0.8 \
    ca-certificates \
    bash \
    && rm -rf /var/lib/apt/lists/*

# ================================
# Runtime layout
# ================================
RUN mkdir -p \
    /opt/scream/bin \
    /opt/scream/gstscream \
    /opt/scream/code

# ================================
# Copy gstscream
# ================================
COPY --from=builder /opt/scream/gstscream/scripts \
    /opt/scream/gstscream/scripts

COPY --from=builder /opt/scream/gstscream/target/debug \
    /opt/scream/gstscream/target/debug

COPY --from=builder /opt/scream/code/wrapper_lib \
    /opt/scream/code/wrapper_lib

# ================================
# Copy SCReAM sender / receiver
# ================================
COPY --from=builder \
    /opt/scream/multicam/sender/scream/bin/scream_sender \
    /opt/scream/bin/scream_sender

COPY --from=builder \
    /opt/scream/multicam/receiver/scream/bin/scream_receiver \
    /opt/scream/bin/scream_receiver

RUN chmod +x /opt/scream/bin/scream_sender \
             /opt/scream/bin/scream_receiver

# ================================
# Environment
# ================================
ENV GST_PLUGIN_PATH=/opt/scream/gstscream/target/debug:/usr/lib/x86_64-linux-gnu/gstreamer-1.0
ENV LD_LIBRARY_PATH=/opt/scream/code/wrapper_lib

# ================================
# Entrypoint
# ================================
COPY entrypoints/entrypoint_minimal.sh /entrypoint_minimal.sh
RUN chmod +x /entrypoint_minimal.sh

ENTRYPOINT ["/entrypoint_minimal.sh"]
CMD ["bash"]
