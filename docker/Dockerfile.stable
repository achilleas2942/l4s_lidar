# ================================
# Build arguments (easy upgrades)
# ================================
ARG ROS_DISTRO=rolling

# ================================
# Stage 1: Builder
# ================================
FROM ros:${ROS_DISTRO}-ros-base AS builder

ENV DEBIAN_FRONTEND=noninteractive

# ---- Build dependencies only ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    pkg-config \
    libssl-dev \
    libsrtp2-dev \
    libnice-dev \
    libglib2.0-dev \
    libjsoncpp-dev \
    libyaml-cpp-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    libgstreamer-plugins-bad1.0-dev \
    gstreamer1.0-alsa \
    gstreamer1.0-gl \
    gstreamer1.0-gtk3 \
    gstreamer1.0-qt5 \
    gstreamer1.0-pulseaudio \
    pkg-config \
    && rm -rf /var/lib/apt/lists/*

# ---- Install Rust (for gstscream) ----
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y
ENV PATH="/root/.cargo/bin:${PATH}"

# ---- Build SCReAM ----
WORKDIR /opt
RUN git clone --depth=1 https://github.com/EricssonResearch/scream.git && \
    cd scream/gstscream/scripts && \
    ./build.sh --release

RUN strip /opt/scream/gstscream/target/debug/*.so || true

# ================================
# Stage 2: Runtime (minimal)
# ================================
FROM ros:${ROS_DISTRO}-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=${ROS_DISTRO}

# ================================
# Runtime dependencies only
# ================================
RUN apt-get update && apt-get install -y --no-install-recommends \
    # ---- GStreamer runtime ----
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    gstreamer1.0-plugins-bad \
    gstreamer1.0-plugins-ugly \
    gstreamer1.0-libav \
    gstreamer1.0-rtsp \
    # ---- Networking / L4S user-space ----
    iproute2 \
    ethtool \
    tcpdump \
    iputils-ping \
    libssl-dev \
    libsrtp2-1 \
    libnice-dev \
    libjsoncpp-dev \
    libyaml-cpp-dev \
    # ---- Misc ----
    psmisc \
    ca-certificates \
    bash \
    && rm -rf /var/lib/apt/lists/*

# ================================
# Copy SCReAM from builder
# ================================
COPY --from=builder /opt/scream/gstscream/scripts /opt/scream/gstscream/scripts
COPY --from=builder /opt/scream/gstscream/target/debug /opt/scream/gstscream/target/debug
COPY --from=builder /opt/scream/code/wrapper_lib /opt/scream/code/wrapper_lib

# ================================
# Entrypoint
# ================================
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]
