# ================================
# Build arguments (easy upgrades)
# ================================
ARG ROS_DISTRO=rolling

# ================================
# Stage 1: Builder
# ================================
FROM ros:${ROS_DISTRO}-ros-base AS builder

ENV DEBIAN_FRONTEND=noninteractive
ENV PKG_CONFIG_PATH=/usr/lib/x86_64-linux-gnu/pkgconfig:/usr/lib/pkgconfig
ENV PATH="/root/.cargo/bin:${PATH}"

# ---- Build dependencies only ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    cmake \
    git \
    curl \
    pkg-config \
    libssl-dev \
    libsrtp2-dev \
    libnice-dev \
    libglib2.0-dev \
    libjsoncpp-dev \
    libyaml-cpp-dev \
    libgstreamer1.0-dev \
    libgstreamer-plugins-base1.0-dev \
    && rm -rf /var/lib/apt/lists/*

# ---- Install Rust (for gstscream) ----
RUN curl https://sh.rustup.rs -sSf | sh -s -- -y

WORKDIR /opt
RUN git clone --depth=1 https://github.com/EricssonResearch/scream.git && \
    cd scream/gstscream/scripts && \
    ./build.sh --release

RUN find /opt/scream/gstscream/target -name "*.so" -exec strip --strip-unneeded {} + || true

# ================================
# Stage 2: Runtime (minimal)
# ================================
FROM ros:${ROS_DISTRO}-ros-base

ENV DEBIAN_FRONTEND=noninteractive
ENV ROS_DISTRO=${ROS_DISTRO}

# ---- Runtime dependencies only ----
RUN apt-get update && apt-get install -y --no-install-recommends \
    gstreamer1.0-tools \
    gstreamer1.0-plugins-base \
    gstreamer1.0-plugins-good \
    iproute2 \
    iputils-ping \
    libssl3 \
    libsrtp2-1 \
    libnice10 \
    libjsoncpp25 \
    libyaml-cpp0.8 \
    psmisc \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# ---- Copy only what is strictly needed ----
COPY --from=builder /opt/scream/gstscream/scripts /opt/scream/gstscream/scripts
COPY --from=builder /opt/scream/gstscream/target/debug  /opt/scream/gstscream/target/debug 
COPY --from=builder /opt/scream/code/wrapper_lib /opt/scream/code/wrapper_lib

ENV GST_PLUGIN_PATH=/opt/scream/gstscream/target/debug:/usr/lib/x86_64-linux-gnu/gstreamer-1.0
ENV LD_LIBRARY_PATH=/opt/scream/code/wrapper_lib

# ================================
# Entrypoint
# ================================
COPY entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh

ENTRYPOINT ["/entrypoint.sh"]
CMD ["bash"]